# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the blanks.
# .env.local is gitignored - never commit real keys.
# ---------------------------------------------------------------------------

# Public site origin. Must match exactly what the browser uses, because
# Paystack and Google both redirect back here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Bypasses row level security - server side only, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack ---------------------------------------------------------------
# Dashboard -> Settings -> API Keys & Webhooks. Use the TEST keys while building.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# --- Mailgun ----------------------------------------------------------------
MAILGUN_API_KEY=
MAILGUN_DOMAIN=sandbox123.mailgun.org
MAILGUN_FROM=Northbound <orders@sandbox123.mailgun.org>
# EU-region Mailgun accounts only:
# MAILGUN_BASE_URL=https://api.eu.mailgun.net

# --- Store settings ---------------------------------------------------------
NEXT_PUBLIC_STORE_NAME=Northbound
# Paystack supports NGN, GHS, ZAR, KES and USD. Must match your Paystack account.
NEXT_PUBLIC_CURRENCY=NGN
# Amounts in the minor unit (kobo). 250000 = NGN 2,500.00
SHIPPING_FEE_MINOR=250000
# Free delivery at or above this subtotal. 10000000 = NGN 100,000.00
FREE_SHIPPING_THRESHOLD_MINOR=10000000

# Comma-separated emails that get admin access before is_admin is set in the
# database. Used to let the first admin in; safe to clear afterwards.
ADMIN_EMAILS=you@example.com
